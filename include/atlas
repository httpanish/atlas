#pragma once

#include <string>
#include <string_view>
#include <unordered_map>
#include <cstddef>
#include <optional>

namespace atlas {

class Request {
public:
    Request() = default;
    Request(std::string method, std::string path, std::string body = "");

    const std::string& method() const;
    const std::string& path() const;
    const std::string& body() const;

private:
    std::string method_ = "GET";
    std::string path_ = "/";
    std::string body_;
};

class Response {
public:
    Response() = default;
    Response(std::string body);
    Response(int status_code, std::string body);

    int status_code() const;
    const std::string& body() const;

private:
    int status_code_ = 200;
    std::string body_;
};

class App {
public:
    App() = default;

    // Operator[] allows: app["/"] = "Hello World!";
    // Returns a reference to the string in the map.
    std::string& operator[](const std::string& path);

    // Const version for reading from a const App.
    // Throws std::out_of_range if the path is not found.
    const std::string& operator[](const std::string& path) const;

    // Check if a route exists.
    bool contains(const std::string& path) const;

    // Retrieve the string value for a path (or empty string if missing).
    std::string get(const std::string& path) const;

    // Returns the number of registered routes.
    std::size_t size() const;

    // Handles an incoming Request and produces a Response.
    Response handle(const Request& req) const;

private:
    std::unordered_map<std::string, std::string> routes_;
};

// Streaming table-driven HTTP parser
class HttpParser {
public:
    enum State {
        STATE_METHOD = 0,
        STATE_PATH = 1,
        STATE_VERSION = 2,
        STATE_REQ_LINE_CR = 3,
        STATE_HEADER_START = 4,
        STATE_HEADER_LINE = 5,
        STATE_HEADER_LINE_CR = 6,
        STATE_EMPTY_LINE_CR = 7,
        STATE_COMPLETE = 8,
        STATE_ERROR = 9
    };

    HttpParser() = default;

    // Feed a chunk of bytes to the parser. Returns false if an error occurred.
    bool feed(const char* data, std::size_t size);
    bool feed(std::string_view chunk);

    // State queries
    bool is_complete() const;
    bool has_error() const;
    State state() const;

    // Produces the Request once parsing is complete.
    std::optional<Request> get_request() const;

    // Reset back to initial state
    void reset();

private:
    void consume_char(char c);

    State state_ = STATE_METHOD;
    std::string method_;
    std::string path_;
    std::string version_;
};

// Convenience helper to parse a full string in one go.
std::optional<Request> parse_request(const std::string& raw);

// Serializes a Response object into a raw HTTP/1.1 response string.
std::string serialize_response(const Response& response);

// A simple RAII wrapper around a POSIX socket file descriptor.
class Socket {
public:
    Socket() = default;
    explicit Socket(int fd);
    ~Socket();

    // Sockets own unique file descriptors: prevent copying.
    Socket(const Socket&) = delete;
    Socket& operator=(const Socket&) = delete;

    // Allow moving ownership of the file descriptor.
    Socket(Socket&& other) noexcept;
    Socket& operator=(Socket&& other) noexcept;

    // Accessors and state
    int get() const noexcept;
    bool is_valid() const noexcept;
    void close();

private:
    int fd_ = -1;
};

// Runs a minimal single-threaded HTTP server that accepts ONE connection on port,
// parses the request, dispatches it to the App, sends the HTTP response, and closes.
void run_single_connection_server(const App& app, int port = 8080);

// Convenience overload using a default empty App.
void run_single_connection_server(int port = 8080);

} // namespace atlas
