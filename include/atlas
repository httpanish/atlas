namespace atlas {

// ============================================================================
// HTTP messages
// ============================================================================

class Request {
public:
    Request() = default;
    Request(std::string method, std::string path, std::string body = "")
        : method_(std::move(method)), path_(std::move(path)), body_(std::move(body)) {}

    const std::string& method() const { return method_; }
    const std::string& path() const { return path_; }
    const std::string& body() const { return body_; }

private:
    std::string method_ = "GET";
    std::string path_ = "/";
    std::string body_;
};

class Response {
public:
    Response() = default;
    Response(std::string body) : body_(std::move(body)) {}
    Response(int status_code, std::string body)
        : status_code_(status_code), body_(std::move(body)) {}

    int status_code() const { return status_code_; }
    const std::string& body() const { return body_; }

private:
    int status_code_ = 200;
    std::string body_;
};

// ============================================================================
// Routing: an App is a map of path -> response body
// ============================================================================

class App {
public:
    // Register or overwrite a route:  app["/"] = "Hello World!";
    std::string& operator[](const std::string& path);

    // Read-only lookup. Throws std::out_of_range if the path is not registered.
    const std::string& operator[](const std::string& path) const;

    bool contains(const std::string& path) const;

    // Returns the route's body, or an empty string if the path is not registered.
    std::string get(const std::string& path) const;

    std::size_t size() const;

    // Produces a 200 with the route's body, or a 404 if the path is not registered.
    Response handle(const Request& req) const;

private:
    std::unordered_map<std::string, std::string> routes_;
};

// ============================================================================
// Parsing: a streaming, table-driven HTTP request parser
// ============================================================================
//
// Bytes can be fed in chunks of any size (even one byte at a time). Each byte
// is classified with a lookup table, and the next state comes from a
// transition table. See src/parser.cpp for both tables.

class HttpParser {
public:
    // The numeric values index rows of the transition table, so keep them in order.
    enum State {
        STATE_METHOD = 0,
        STATE_PATH = 1,
        STATE_VERSION = 2,
        STATE_REQ_LINE_CR = 3,
        STATE_HEADER_START = 4,
        STATE_HEADER_LINE = 5,
        STATE_HEADER_LINE_CR = 6,
        STATE_EMPTY_LINE_CR = 7,
        STATE_COMPLETE = 8,
        STATE_ERROR = 9
    };

    // Feeds a chunk of bytes. Returns false once the input has been rejected.
    bool feed(const char* data, std::size_t size);
    bool feed(std::string_view chunk);

    bool is_complete() const { return state_ == STATE_COMPLETE; }
    bool has_error() const { return state_ == STATE_ERROR; }
    State state() const { return state_; }

    // Returns the parsed Request, or std::nullopt until parsing is complete.
    std::optional<Request> get_request() const;

    // Clears all state so the parser can be reused for another request.
    void reset();

private:
    void consume_char(char c);
    void append_to_token(char c);
    bool finished_token_is_valid() const;

    State state_ = STATE_METHOD;
    std::string method_;
    std::string path_;
    std::string version_;
};

// Parses a complete request held in a single string.
std::optional<Request> parse_request(const std::string& raw);

// ============================================================================
// Serialization
// ============================================================================

// Converts a Response into HTTP/1.1 wire format.
std::string serialize_response(const Response& response);

// ============================================================================
// Networking
// ============================================================================

// Owns a POSIX socket file descriptor and closes it on destruction (RAII).
// Move-only, because exactly one object may own a given descriptor.
class Socket {
public:
    Socket() = default;
    explicit Socket(int fd) : fd_(fd) {}
    ~Socket() { close(); }

    Socket(const Socket&) = delete;
    Socket& operator=(const Socket&) = delete;

    Socket(Socket&& other) noexcept;
    Socket& operator=(Socket&& other) noexcept;

    int get() const noexcept { return fd_; }
    bool is_valid() const noexcept { return fd_ >= 0; }
    void close();

private:
    int fd_ = -1;
};

// Listens on 127.0.0.1:port, serves exactly ONE request with the given App,
// then closes the connection and returns.
void run_single_connection_server(const App& app, int port = 8080);

// Same as above, using an App that only serves "/".
void run_single_connection_server(int port = 8080);

} // namespace atlas
